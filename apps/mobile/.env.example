# The API the app talks to. On the Android emulator, localhost is http://10.0.2.2:3000/v1.
# On a real phone, use your computer's address on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# Development only: "lat,lng" used when the device gives no location, for example in the web build.
# EXPO_PUBLIC_DEV_LOCATION=26.8505,75.7628

# The tracking map's tiles. Without these, OpenStreetMap's public tiles are used, which suit development only.
# Set them to your Ola Maps (or other) raster tile address, with {z}/{x}/{y} and your key, before launch.
# EXPO_PUBLIC_MAP_TILE_URL=
# EXPO_PUBLIC_MAP_ATTRIBUTION=
