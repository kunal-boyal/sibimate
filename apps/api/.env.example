NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://sibimate:sibimate@localhost:5432/sibimate
# Generate each with: openssl rand -base64 32
JWT_SECRET=
OTP_SECRET=
# Encrypts exact addresses. Generate with: openssl rand -base64 32
ADDRESS_KEY=
# Encrypts admins' authenticator secrets. Generate with: openssl rand -base64 32
TOTP_KEY=
# openai = a model writes the details and voice works; rules = keyword stand-in for development, no voice;
# none = customers use the typed form
TASK_INTERPRETER=rules
# Needed for TASK_INTERPRETER=openai. Create a key at platform.openai.com.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-sol
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# console prints codes in the log; msg91 sends real SMS once your DLT template is approved
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_OTP_VARIABLE=VAR1
# local keeps helpers' documents in STORAGE_ROOT; s3 uses a private bucket in Mumbai
STORAGE_DRIVER=local
STORAGE_ROOT=.data
# S3_DOCUMENTS_BUCKET=
# S3_REGION=ap-south-1
# Browser origins allowed to call the API, comma separated. 8081 is the app's web build in development.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# Matching jobs. redis = queued for the worker process (pnpm --filter @sibimate/api dev:worker);
# inline = run inside the API process, for development without a worker
REDIS_URL=redis://localhost:6379
MATCHING_QUEUE=inline
